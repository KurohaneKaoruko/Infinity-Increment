{
  // Cloudflare Worker: 排行榜 API + 单文件游戏静态托管一体。
  // 部署:npm run worker:deploy  (= vite build && wrangler deploy)
  "name": "infinity-increment",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",

  // 排行榜存储:代码里只认 env.LEADERBOARD 这个 binding 名。
  // 刻意不写 id —— 交给自动供给(automatic provisioning):
  //   * Git 构建(dashboard 部署):自动创建 namespace,id 只存在于 dashboard,
  //     不会写回仓库 → 仓库里零 id;
  //   * 本地 `wrangler deploy`:同样自动创建,但会把真实 id 写回本文件。
  "kv_namespaces": [
    {
      "binding": "LEADERBOARD"
    }
  ],

  // 静态资源:dist/ 由运行时先行匹配;未命中的请求(含 /api/leaderboard)进 Worker,
  // 其余未命中路径由 worker/index.ts 回退到 index.html(单文件游戏)。
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  }
}
